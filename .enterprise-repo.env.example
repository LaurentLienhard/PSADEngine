# ---------------------------------------------------------------------------
# Enterprise SMB PowerShell repository - local build configuration TEMPLATE
# ---------------------------------------------------------------------------
# Consumed by the Invoke-Build task 'Publish_Module_To_EnterpriseRepository'
# (./.build/PublishEnterpriseRepository.build.ps1).
#
# USAGE (developer workstation)
#   Copy this file to '.enterprise-repo.env' (git-ignored) and adjust the values:
#       Copy-Item -Path './.enterprise-repo.env.example' -Destination './.enterprise-repo.env'
#       ./build.ps1 -Tasks build, publish-enterprise
#
# PRECEDENCE (evaluated per setting, highest first)
#   1. ./build.ps1 -Parameters @{ ... }      <- preferred, see the section below
#   2. Invoke-Build property / session variable ($EnterpriseSmbShare, ...)
#   3. Process environment variables (ENTERPRISE_REPO_*)   <- CI/CD injection
#   4. THIS FILE                                           <- workstation defaults
#   5. Built-in defaults
#
#   Because precedence is applied setting by setting, you can keep the share in
#   this file and pass only the credential as a parameter.
#
# SECURITY
#   ENTERPRISE_REPO_PASSWORD is REFUSED from this file by design (the task emits a
#   warning and ignores it). Prefer a PSCredential passed as a build parameter, or
#   Microsoft.PowerShell.SecretManagement locally, or GitHub Secrets / Azure DevOps
#   secret variables in CI/CD.
# ---------------------------------------------------------------------------

# REQUIRED - master switch. When absent (and no EnterpriseSmbShare parameter is
# supplied), the task is skipped and the build succeeds.
ENTERPRISE_REPO_SMB_SHARE=\\FS01\PowerShellRepo

# OPTIONAL - name of a SecretManagement secret holding a PSCredential, or a
# SecureString combined with ENTERPRISE_REPO_USERNAME below.
#   Register-SecretVault -Name 'CorpVault' -ModuleName 'Microsoft.PowerShell.SecretStore' -DefaultVault
#   Set-Secret -Name 'PSRepoPublisher' -Secret (Get-Credential)
# ENTERPRISE_REPO_CREDENTIAL=PSRepoPublisher

# OPTIONAL - SecretManagement vault name. Omit to use the default vault.
# ENTERPRISE_REPO_VAULT=CorpVault

# OPTIONAL - service account used to write on the share. Combined either with the
# SecureString secret above, or with ENTERPRISE_REPO_PASSWORD injected by CI/CD.
# ENTERPRISE_REPO_USERNAME=CORP\svc_psrepo

# OPTIONAL - explicit built module folder, overriding the automatic discovery of
# output/module/<ProjectName>/<Version>.
# ENTERPRISE_REPO_MODULE_PATH=./output/module/PSADEngine/1.2.3

# OPTIONAL - dry run: validates configuration, credentials and paths, writes nothing.
# ENTERPRISE_REPO_WHATIF=true

# ---------------------------------------------------------------------------
# PREFERRED INTERACTIVE USAGE - build parameters (no secret in the environment)
# ---------------------------------------------------------------------------
# A [PSCredential] passed through -Parameters stays a SecureString inside the
# PowerShell process. It never reaches the process environment, the command line,
# the shell history, a transcript or a build log - unlike ENTERPRISE_REPO_PASSWORD.
#
#   # 1. Share + interactive credential
#   $publishParam = @{
#       EnterpriseSmbShare   = '\\FS01\PowerShellRepo'
#       EnterpriseCredential = (Get-Credential -UserName 'CORP\svc_psrepo' -Message 'Enterprise repository')
#   }
#   ./build.ps1 -Tasks build, publish-enterprise -Parameters $publishParam
#
#   # 2. Same thing, credential captured first
#   $credential = Get-Credential -UserName 'CORP\svc_psrepo' -Message 'Enterprise repository'
#   ./build.ps1 -Tasks build, publish-enterprise -Parameters @{
#       EnterpriseSmbShare   = '\\FS01\PowerShellRepo'
#       EnterpriseCredential = $credential
#   }
#
#   # 3. Credential read from a SecretManagement vault, share from a parameter
#   ./build.ps1 -Tasks build, publish-enterprise -Parameters @{
#       EnterpriseSmbShare             = '\\FS01\PowerShellRepo'
#       EnterpriseCredentialSecretName = 'PSRepoPublisher'
#       EnterpriseVaultName            = 'CorpVault'
#   }
#
#   # 4. Dry run against an explicit share, build agent identity
#   ./build.ps1 -Tasks build, publish-enterprise -Parameters @{
#       EnterpriseSmbShare = '\\FS01\PowerShellRepo'
#       EnterpriseDryRun   = $true
#   }
#
#   # 5. Hybrid: share from this file / the environment, credential from a parameter
#   ./build.ps1 -Tasks build, publish-enterprise -Parameters @{
#       EnterpriseCredential = (Get-Credential 'CORP\svc_psrepo')
#   }
#
#   # 6. Override capability: the parameter wins over an exported variable
#   $env:ENTERPRISE_REPO_SMB_SHARE = '\\FS01\PowerShellRepo'
#   ./build.ps1 -Tasks publish-enterprise -Parameters @{
#       EnterpriseSmbShare = '\\FS02\StagingRepo'   # <- this one is used
#   }
#
# ACCEPTED PARAMETER KEYS (each also accepts an 'EnterpriseRepository*' spelling)
#   EnterpriseSmbShare              -> ENTERPRISE_REPO_SMB_SHARE
#   EnterpriseCredential            -> (no environment equivalent, by design)
#   EnterpriseUserName              -> ENTERPRISE_REPO_USERNAME
#   EnterpriseCredentialSecretName  -> ENTERPRISE_REPO_CREDENTIAL
#   EnterpriseVaultName             -> ENTERPRISE_REPO_VAULT
#   EnterpriseModulePath            -> ENTERPRISE_REPO_MODULE_PATH
#   EnterpriseDryRun                -> ENTERPRISE_REPO_WHATIF
#
# Unknown keys are ignored, so the same table can carry settings for other tasks.
#
# ---------------------------------------------------------------------------
# CI/CD reference - GitHub Actions (Windows runner required for SMB)
# ---------------------------------------------------------------------------
# Environment variables remain the right mechanism in CI/CD: a secret store has no
# other way to inject a value. Nothing below changed - it is fully supported.
#
#   jobs:
#     publish:
#       runs-on: windows-latest
#       steps:
#         - uses: actions/checkout@v4
#           with:
#             fetch-depth: 0
#         - name: Publish
#           shell: pwsh
#           env:
#             GitHubToken:               ${{ secrets.GITHUB_TOKEN }}
#             GalleryApiToken:           ${{ secrets.GALLERY_API_TOKEN }}
#             ENTERPRISE_REPO_SMB_SHARE: ${{ vars.ENTERPRISE_REPO_SMB_SHARE }}
#             ENTERPRISE_REPO_USERNAME:  ${{ secrets.ENTERPRISE_REPO_USERNAME }}
#             ENTERPRISE_REPO_PASSWORD:  ${{ secrets.ENTERPRISE_REPO_PASSWORD }}
#           run: ./build.ps1 -Tasks publish -ResolveDependency
#
# ---------------------------------------------------------------------------
# CI/CD reference - Azure Pipelines (self-hosted Windows agent on the corp network)
# ---------------------------------------------------------------------------
#   - task: PowerShell@2
#     displayName: Publish to enterprise repository
#     inputs:
#       filePath: ./build.ps1
#       arguments: -Tasks publish-enterprise
#       pwsh: true
#     env:
#       ENTERPRISE_REPO_SMB_SHARE: $(EnterpriseRepoSmbShare)
#       ENTERPRISE_REPO_USERNAME:  $(EnterpriseRepoUserName)
#       ENTERPRISE_REPO_PASSWORD:  $(EnterpriseRepoPassword)   # secret variable
#
#   # Variant keeping the password out of the agent environment entirely: build the
#   # PSCredential in an inline script and hand it over as a build parameter.
#   - task: PowerShell@2
#     displayName: Publish to enterprise repository (parameter form)
#     inputs:
#       targetType: inline
#       pwsh: true
#       script: |
#         $securePassword = ConvertTo-SecureString -String '$(EnterpriseRepoPassword)' -AsPlainText -Force
#         $credential = [System.Management.Automation.PSCredential]::new('$(EnterpriseRepoUserName)', $securePassword)
#         ./build.ps1 -Tasks publish-enterprise -Parameters @{
#             EnterpriseSmbShare   = '$(EnterpriseRepoSmbShare)'
#             EnterpriseCredential = $credential
#         }
