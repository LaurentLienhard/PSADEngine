# ---------------------------------------------------------------------------
# Enterprise SMB PowerShell repository - local build configuration TEMPLATE
# ---------------------------------------------------------------------------
# Consumed by the Invoke-Build task 'Publish_Module_To_EnterpriseRepository'
# (./.build/PublishEnterpriseRepository.build.ps1).
#
# USAGE (developer workstation)
#   Copy this file to '.enterprise-repo.env' (git-ignored) and adjust the values:
#       Copy-Item -Path './.enterprise-repo.env.example' -Destination './.enterprise-repo.env'
#       ./build.ps1 -Tasks build, publish-enterprise
#
# PRECEDENCE
#   Process environment variables ALWAYS win over this file, so a CI/CD runner is
#   never overridden by a developer workstation file.
#
# SECURITY
#   ENTERPRISE_REPO_PASSWORD is REFUSED from this file by design (the task emits a
#   warning and ignores it). Use Microsoft.PowerShell.SecretManagement locally and
#   GitHub Secrets / Azure DevOps secret variables in CI/CD.
# ---------------------------------------------------------------------------

# REQUIRED - master switch. When absent, the task is skipped and the build succeeds.
ENTERPRISE_REPO_SMB_SHARE=\\FS01\PowerShellRepo

# OPTIONAL - name of a SecretManagement secret holding a PSCredential, or a
# SecureString combined with ENTERPRISE_REPO_USERNAME below.
#   Register-SecretVault -Name 'CorpVault' -ModuleName 'Microsoft.PowerShell.SecretStore' -DefaultVault
#   Set-Secret -Name 'PSRepoPublisher' -Secret (Get-Credential)
# ENTERPRISE_REPO_CREDENTIAL=PSRepoPublisher

# OPTIONAL - SecretManagement vault name. Omit to use the default vault.
# ENTERPRISE_REPO_VAULT=CorpVault

# OPTIONAL - service account used to write on the share. Combined either with the
# SecureString secret above, or with ENTERPRISE_REPO_PASSWORD injected by CI/CD.
# ENTERPRISE_REPO_USERNAME=CORP\svc_psrepo

# OPTIONAL - explicit built module folder, overriding the automatic discovery of
# output/module/<ProjectName>/<Version>.
# ENTERPRISE_REPO_MODULE_PATH=./output/module/PSADEngine/1.2.3

# OPTIONAL - dry run: validates configuration, credentials and paths, writes nothing.
# ENTERPRISE_REPO_WHATIF=true

